# Copy to .env.local for local development. Set real values in Vercel Project Settings.
# Never commit .env.local or real credentials.
GEMINI_API_KEY=replace_with_your_gemini_api_key
APP_URL=http://localhost:3000
NUBRA_API_BASE_URL=https://api.nubra.io
NUBRA_AUTH_TOKEN=
NUBRA_DEVICE_ID=
BROKER_SESSION_SECRET=replace_with_a_long_random_secret
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
ALERT_EMAIL_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_WEBHOOK_URL=
ALERT_SMS_API_KEY=

# Firebase browser configuration (public values, supplied at build time)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
