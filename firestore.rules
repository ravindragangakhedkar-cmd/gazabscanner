rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() &&
        request.auth.token.email in ['YOUR_ADMIN_EMAIL@example.com', 'YOUR_SUPPORT_EMAIL@example.com'];
    }

    // Entity validators
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'subscriptionTier',
          'subscriptionStatus', 'trialEndsAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'displayName', 'subscriptionTier',
          'subscriptionStatus', 'trialEndsAt', 'planPurchasedAt',
          'googlePlayOrderId', 'paymentLinkedAccount', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.subscriptionTier in ['trial', 'monthly', 'yearly'] &&
        data.subscriptionStatus in ['active', 'expired'] &&
        data.trialEndsAt is timestamp &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (!('planPurchasedAt' in data) || data.planPurchasedAt is timestamp) &&
        (!('googlePlayOrderId' in data) || (
          data.googlePlayOrderId is string &&
          data.googlePlayOrderId.size() >= 4 &&
          data.googlePlayOrderId.size() <= 100 &&
          data.googlePlayOrderId.matches('^[a-zA-Z0-9_\\-.]+$')
        )) &&
        (!('paymentLinkedAccount' in data) || (
          data.paymentLinkedAccount is string &&
          data.paymentLinkedAccount.size() >= 3 &&
          data.paymentLinkedAccount.size() <= 254 &&
          data.paymentLinkedAccount == 'YOUR_SUPPORT_EMAIL@example.com'
        ));
    }

    function isValidBrokerConnection(data, userId) {
      return data.keys().hasAll([
          'userId', 'brokerName', 'maskedMobile', 'clientCode',
          'status', 'connectedAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'brokerName', 'maskedMobile', 'clientCode',
          'status', 'connectedAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId == userId && isValidId(data.userId) &&
        data.brokerName == 'Broker' &&
        data.maskedMobile is string && data.maskedMobile.size() >= 6 && data.maskedMobile.size() <= 20 &&
        data.clientCode is string && data.clientCode.size() >= 3 && data.clientCode.size() <= 40 &&
        data.clientCode.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.status in ['connected', 'disconnected'] &&
        data.connectedAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSavedScanPick(data, userId) {
      return data.keys().hasAll([
          'userId', 'symbol', 'scanner', 'signal',
          'entryPrice', 'targetPrice', 'stopLoss', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'symbol', 'scanner', 'signal',
          'entryPrice', 'targetPrice', 'stopLoss', 'createdAt'
        ]) &&
        data.userId is string && data.userId == userId && isValidId(data.userId) &&
        data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 30 &&
        data.symbol.matches('^[a-zA-Z0-9_\\-.&]+$') &&
        data.scanner in ['scanner1', 'scanner2', 'scanner3'] &&
        data.signal is string && data.signal.size() >= 1 && data.signal.size() <= 40 &&
        data.entryPrice is number &&
        data.targetPrice is number &&
        data.stopLoss is number &&
        data.createdAt is timestamp;
    }

    function isValidContactInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'message', 'routedTo', 'createdAt']) &&
        data.keys().hasOnly(['name', 'email', 'phone', 'message', 'routedTo', 'createdAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 20 &&
        data.message is string && data.message.size() >= 5 && data.message.size() <= 1500 &&
        data.routedTo is string && data.routedTo.size() >= 3 && data.routedTo.size() <= 254 &&
        data.routedTo == 'YOUR_SUPPORT_EMAIL@example.com' &&
        data.createdAt is timestamp;
    }

    // Users collection (PII isolated to owner only; no blanket list)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isVerified() &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().subscriptionTier == 'trial' &&
        incoming().subscriptionStatus == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerified() &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().trialEndsAt == existing().trialEndsAt &&
        incoming().updatedAt == request.time &&
        (
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'subscriptionTier', 'subscriptionStatus', 'planPurchasedAt',
              'googlePlayOrderId', 'paymentLinkedAccount', 'updatedAt'
            ]) &&
            incoming().subscriptionTier in ['monthly', 'yearly'] &&
            incoming().subscriptionStatus == 'active' &&
            incoming().planPurchasedAt == request.time &&
            'googlePlayOrderId' in incoming() &&
            incoming().paymentLinkedAccount == 'YOUR_SUPPORT_EMAIL@example.com'
          )
        );

      allow delete: if isAdmin() && isValidId(userId);

      // Multi-broker connections (Master Gate verifies parent user exists)
      match /brokerConnections/{connectionId} {
        allow get: if isValidId(userId) && isValidId(connectionId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && isSignedIn() && (
          (request.auth.uid == userId && resource.data.userId == request.auth.uid) || isAdmin()
        );

        allow create: if isVerified() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(connectionId) &&
          isValidBrokerConnection(incoming(), userId) &&
          incoming().connectedAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerified() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(connectionId) &&
          isValidBrokerConnection(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().brokerName == existing().brokerName &&
          incoming().connectedAt == existing().connectedAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'maskedMobile', 'clientCode', 'status', 'updatedAt'
          ]);

        allow delete: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(connectionId);
      }

      // Saved scanner picks (Master Gate verifies parent user exists)
      match /watchlists/{stockId} {
        allow get: if isValidId(userId) && isValidId(stockId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && isSignedIn() && (
          (request.auth.uid == userId && resource.data.userId == request.auth.uid) || isAdmin()
        );

        allow create: if isVerified() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(stockId) &&
          isValidSavedScanPick(incoming(), userId) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(stockId);
      }
    }

    // Contact Us inquiries (create-only dropbox; admin readable)
    match /contactInquiries/{inquiryId} {
      allow get, list, update, delete: if isAdmin() && isValidId(inquiryId);
      allow create: if isValidId(inquiryId) &&
        isValidContactInquiry(incoming()) &&
        incoming().createdAt == request.time;
    }
  }
}
